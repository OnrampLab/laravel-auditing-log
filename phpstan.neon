includes:
  - ./vendor/larastan/larastan/extension.neon
parameters:

    paths:
        - src

    # The level 8 is the highest level
    level: 8

    ignoreErrors:
        # Auditable is a trait for package consumers; nothing in src/ uses it
        - identifier: trait.unused

    excludePaths:
        - ./*/*/tests/*.php
        - ./*/*/factories/*.php
        - ./*/*/migrations/*.php
