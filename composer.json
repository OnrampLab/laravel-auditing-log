{
    "name": "onramplab/laravel-auditing-log",
    "description": "A Laravel package providing auditing log",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "auditing",
        "audit",
        "laravel",
        "package",
        "log",
        "laravel package",
        "laravel audit",
        "laravel auditing"
    ],
    "authors": [
        {
            "name": "Onramp Lab",
            "email": "dev@onramplab.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-activitylog": "^4.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "nunomaduro/phpinsights": "^2.6",
        "onramplab/onr-phpcs-laravel": "^1.2",
        "orchestra/testbench": "^6.25|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpmd/phpmd": "^2.13",
        "phpunit/phpunit": "^9.5|^10.5|^11.5|^12.5",
        "rector/rector": "^2.0",
        "spatie/phpunit-watcher": "^1.23",
        "squizlabs/php_codesniffer": "*"
    },
    "autoload": {
        "psr-4": {
            "OnrampLab\\AuditingLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OnrampLab\\AuditingLog\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.0-dev"
        },
        "laravel": {
            "providers": [
                "OnrampLab\\AuditingLog\\AuditingLogServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": [
            "tools/scripts/run-tests.sh"
        ],
        "test:watch": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit-watcher watch --filter NoneTest < /dev/tty"
        ],
        "psr2check": [
            "@php vendor/bin/phpcs --standard=PSR2 src/"
        ],
        "psr2autofix": [
            "@php vendor/bin/phpcbf --standard=PSR2 src/"
        ],
        "docs": [
            "@php tools/phpDocumentor"
        ],
        "insights": [
            "@php vendor/bin/phpinsights --no-interaction"
        ],
        "insights:fix": [
            "@php vendor/bin/phpinsights --no-interaction --fix"
        ],
        "dependencies:check": [
            "phpmd src text rulesets.xml"
        ],
        "rector": [
            "vendor/bin/rector process src --dry-run"
        ],
        "rector:fix": [
            "vendor/bin/rector process src"
        ]
    }
}
